# =============================================================================
# AgriSmart launch defaults
# -----------------------------------------------------------------------------
# Shared by launch.sh and launch.ps1. Override any value via:
#   1. Environment variables (highest priority)
#   2. A local file: scripts/launch/local.env  (gitignored)
#   3. These defaults (lowest priority)
# =============================================================================

# --- Paths -------------------------------------------------------------------
# Sibling Chloromap ML repo (absolute or relative to AgriSmart root)
CHLOROMAP_DIR=../chloromap
CHLOROMAP_CHECKPOINT=weights/best_model.pth

# Runtime artifacts (PIDs, logs, local Mongo data)
RUN_DIR=.run
LOG_DIR=.run/logs
PID_DIR=.run/pids
MONGO_DATA_DIR=.run/mongodb-data

# --- Ports -------------------------------------------------------------------
CLIENT_PORT=3000
SERVER_PORT=5000
ML_PORT=8000
MONGO_PORT=27017

# --- Hosts -------------------------------------------------------------------
CLIENT_HOST=0.0.0.0
SERVER_HOST=0.0.0.0
ML_HOST=0.0.0.0
MONGO_BIND=127.0.0.1

# --- Service toggles (true|false) --------------------------------------------
# Set via CLI flags as well: --no-db, --no-ml, --no-client, --no-server
ENABLE_DB=true
ENABLE_SERVER=true
ENABLE_CLIENT=true
ENABLE_ML=true

# --- Timeouts / health -------------------------------------------------------
# Seconds to wait for each service to become healthy before continuing
HEALTH_TIMEOUT_SEC=60
HEALTH_POLL_INTERVAL_SEC=1

# --- MongoDB -----------------------------------------------------------------
# Prefer an already-running mongod / Docker / system service when available.
# If none is found and ENABLE_DB=true, the launcher starts a local mongod.
MONGO_DB_NAME=agrismart
MONGODB_URI=mongodb://127.0.0.1:27017/agrismart

# --- Node / app --------------------------------------------------------------
NODE_ENV=development
# npm install is skipped when node_modules already exists unless FORCE_INSTALL=true
FORCE_INSTALL=false

# --- Chloromap / ML ----------------------------------------------------------
# Python runner preference: auto | uv | venv | python
ML_PYTHON_MODE=auto
CHLOROMAP_URL=http://127.0.0.1:8000
